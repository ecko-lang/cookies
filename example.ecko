# cookies demo: a small client session.
import "./main.ecko"
cookies = main

# A login response sets a session cookie.
jar = cookies.parse("session=xyz789; Path=/; HttpOnly; Secure; Max-Age=86400")
print(
    "stored session={jar.session.value} http_only={jar.session.http_only} max_age={jar.session.max_age}",
)

# A later response adds a preference; fold it into the same jar.
jar = cookies.merge(jar, "theme=dark; Path=/")

# Send them all back on the next request.
print("Cookie: {cookies.header(jar)}")
